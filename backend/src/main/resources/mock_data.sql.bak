    ),
    (
        'The Idiot', NULL,
        'Prince Myshkin returns to Russia after years in a Swiss sanatorium. His '
        'innocence and benevolence earn him the epithet "idiot", but in a society '
        'consumed by greed and passion, his simplicity exposes the moral bankruptcy '
        'of those around him.',
        'eng', 656,
        '891.733', 'PG3326',
        'The Russian Messenger', 1869,
        NULL, NULL,
        '0140447938', '9780140447934', 'OL7156812M',
        'https://covers.openlibrary.org/b/olid/OL7156812M-L.jpg'
