INSERT INTO authors (name, bio, nationality, birth_year, death_year, olid, profile_image_url)
VALUES
    (
        'George Orwell',
        'Eric Arthur Blair, known by his pen name George Orwell, was an English novelist, '
        'essayist, journalist and critic. His work is characterised by lucid prose, biting '
        'social criticism, total opposition to totalitarianism, and outspoken support of '
        'democratic socialism.',
        'British',
        1903, 1950,
        'OL1392723A',
        'https://covers.openlibrary.org/a/olid/OL1392723A-L.jpg'
    ),
    (
        'J.R.R. Tolkien',
        'John Ronald Reuel Tolkien was an English author and philologist. He is best known '
        'as the author of the high fantasy works The Hobbit and The Lord of the Rings. '
        'Tolkien was a professor of Anglo-Saxon and later of English Language and Literature '
        'at Oxford University.',
        'British',
        1892, 1973,
        'OL26320A',
        'https://covers.openlibrary.org/a/olid/OL26320A-L.jpg'
    ),
    (
        'Frank Herbert',
        'Franklin Patrick Herbert Jr. was an American science fiction author best known for '
        'the 1965 novel Dune and its five sequels. He was also a journalist, photographer, '
        'short story writer, book reviewer, and ecological consultant.',
        'American',
        1920, 1986,
        'OL26707A',
        'https://covers.openlibrary.org/a/olid/OL26707A-L.jpg'
    ),
    (
        'Fyodor Dostoevsky',
        'Fyodor Mikhailovich Dostoevsky was a Russian novelist, short story writer, essayist '
        'and journalist. His works explore the psychological, moral, and spiritual turmoil '
        'of his characters, and have had a profound influence on literature.',
        'Russian',
        1821, 1881,
        'OL22242A',
        'https://covers.openlibrary.org/a/olid/OL22242A-L.jpg'
    ),
    (
        'Leo Tolstoy',
        'Count Lev Nikolayevich Tolstoy was a Russian author widely regarded as one of the '
        'greatest writers of all time. He is best known for his novels War and Peace and '
        'Anna Karenina, which are often cited as pinnacles of realist fiction.',
        'Russian',
        1828, 1910,
        'OL33434A',
        'https://covers.openlibrary.org/a/olid/OL33434A-L.jpg'
    ),
    (
        'Gabriel García Márquez',
        'Gabriel José de la Concordia García Márquez was a Colombian novelist, short-story '
        'writer, screenwriter, and journalist. He was awarded the Nobel Prize in Literature '
        'in 1982. He is best known for his novel One Hundred Years of Solitude.',
        'Colombian',
        1927, 2014,
        'OL26095A',
        'https://covers.openlibrary.org/a/olid/OL26095A-L.jpg'
    ),
    (
        'Douglas Adams',
        'Douglas Noël Adams was an English author, screenwriter, essayist, humorist, '
        'satirist and dramatist. Adams was author of The Hitchhiker''s Guide to the Galaxy, '
        'which originated in 1978 as a BBC Radio 4 comedy before developing into a '
        '"trilogy in five parts".',
        'British',
        1952, 2001,
        'OL23919A',
        'https://covers.openlibrary.org/a/olid/OL23919A-L.jpg'
    ),
    (
        'Ursula K. Le Guin',
        'Ursula Kroeber Le Guin was an American author best known for her works of '
        'speculative fiction, including science fiction works set in her Hainish universe, '
        'and the Earthsea fantasy series. Her writing explored themes of anarchism, '
        'gender, and anthropology.',
        'American',
        1929, 2018,
        'OL152A',
        'https://covers.openlibrary.org/a/olid/OL152A-L.jpg'
    ),
    (
        'Isaac Asimov',
        'Isaac Asimov was an American author and professor of biochemistry at Boston '
        'University. During his lifetime, Asimov was considered one of the "Big Three" '
        'science fiction writers. He wrote or edited more than 500 books and an estimated '
        '90,000 letters and postcards.',
        'American',
        1920, 1992,
        'OL34221A',
        'https://covers.openlibrary.org/a/olid/OL34221A-L.jpg'
    ),
    (
        'Cormac McCarthy',
        'Cormac McCarthy was an American novelist, playwright, and screenwriter. He wrote '
        'twelve novels in the Southern Gothic, Appalachian, and neo-Western genres. He '
