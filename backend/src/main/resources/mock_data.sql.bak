    ('OL7353545M', 'OL23919A'),     -- H2G2            → Adams
    ('OL7353546M', 'OL23919A'),     -- Restaurant      → Adams
    ('OL7353547M', 'OL23919A'),     -- Life Universe   → Adams
    ('OL7353580M', 'OL152A'),       -- Left Hand       → Le Guin
    ('OL7353581M', 'OL152A'),       -- Dispossessed    → Le Guin
    ('OL7353582M', 'OL152A'),       -- Wizard          → Le Guin
    ('OL7353560M', 'OL34221A'),     -- Foundation      → Asimov
    ('OL7353561M', 'OL34221A'),     -- F & Empire      → Asimov
    ('OL7353562M', 'OL34221A'),     -- 2nd Foundation  → Asimov
    ('OL17854096M','OL2649852A'),   -- The Road        → McCarthy
    ('OL18269415M','OL2649852A'),   -- Blood Meridian  → McCarthy
    ('OL17927193M','OL2649852A')    -- No Country      → McCarthy
) AS mapping (book_olid, author_olid)
JOIN books   b ON b.olid = book_olid
JOIN authors a ON a.olid = author_olid
ON CONFLICT (book_id, author_id, role) DO NOTHING;
